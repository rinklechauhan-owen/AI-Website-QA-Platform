# Copy to .env and fill in. Defaults match docker-compose.yml.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=info
API_BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5432/website_qa

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Crawler ---
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=30
CRAWL_USER_AGENT=AI-Website-QA-Platform/1.0
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_CONCURRENCY=4

# --- Screenshot / artifact storage ---
# STORAGE_BACKEND: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# --- Auth (Phase 4) ---
JWT_SECRET=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
